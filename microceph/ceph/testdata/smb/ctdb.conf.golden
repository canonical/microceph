[logging]
    location = file:/var/snap/microceph/common/logs/ctdb/log.ctdb
    log level = NOTICE

[database]
    volatile database directory = /var/snap/microceph/common/data/ctdb/volatile
    persistent database directory = /var/snap/microceph/common/data/ctdb/persistent
    state database directory = /var/snap/microceph/common/data/ctdb/state

[cluster]
    cluster lock = !/snap/microceph/current/libexec/ctdb/ctdb_mutex_ceph_rados_helper ceph client.smb.dev.host1 .smb microceph.reclock.dev
