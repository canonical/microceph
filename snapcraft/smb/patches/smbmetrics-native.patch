 func resolveSambaVersion() (string, error) {
+	if os.Getenv("SMBMETRICS_SMBCONF") != "" {
+		if os.Getenv("SMBMETRICS_SMBSTATUS") == "" {
+			return "", errors.New("native smbstatus executable is not configured")
+		}
+		version, err := RunSMBStatusVersion()
+		return strings.TrimPrefix(version, "Version "), err
+	}
 	return executeRpmQCommand("samba")
 }
 
 func resolveCtdbVersion() (string, error) {
+	if os.Getenv("SMBMETRICS_SMBCONF") != "" {
+		binary := os.Getenv("SMBMETRICS_CTDB")
+		if binary == "" {
+			return "", errors.New("native CTDB executable is not configured")
+		}
+		return executeCommand(binary, "version")
+	}
 	return executeRpmQCommand("ctdb")
 }
 
