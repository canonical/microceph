+func nativeListenAddress(addresses []net.IP, port int) (string, error) {
+	switch len(addresses) {
+	case 0:
+		return net.JoinHostPort("", strconv.Itoa(port)), nil
+	case 1:
+		return net.JoinHostPort(addresses[0].String(), strconv.Itoa(port)), nil
+	default:
+		return "", fmt.Errorf("too many listen addresses")
+	}
+}
