#!/bin/bash
set -eu

# shellcheck disable=SC2155
export SNAP_CURRENT="$(realpath "${SNAP_DATA}/..")/current"
echo $$ > "${SNAP_CURRENT}/run/ceph-osd.pid"
cd "${SNAP}"

. "${SNAP}/commands/common"

limits

maybe_unlock() {
    dev="${1:?missing}"
    osdid="${2:?missing}"
    key="${3:?missing}"
    suffix="${4:-}"

    luksname="luksosd${suffix}-${osdid}"

    [ -b "/dev/mapper/$luksname" ] && return

    if cryptsetup isLuks "$dev" ; then
        echo "${key}" | cryptsetup luksOpen "$dev" "$luksname" --key-file - --keyfile-size 128
    fi
}

get_key() {
    osdid="${1:?missing}"
    suffix="${2:-}"
    ceph config-key get "microceph:osd${suffix}.${osdid}/key"
}

# unlock_osd opens every encrypted device (data, WAL, DB) of one OSD. It
# reports failure through its return code rather than letting `set -eu` (or
# the `:?` guard in maybe_unlock, which exits the shell on an empty key) abort
# the wrapper, so an OSD whose key cannot be fetched or whose LUKS open fails
# does not leave every later OSD on the node locked. See issue #808.
unlock_osd() {
    local dir="${1:?missing}"
    local id="${2:?missing}"
    local sfx devkey

    for sfx in "" ".wal" ".db"; do
        [ -b "${dir}/unencrypted${sfx}" ] || continue

        devkey="$( get_key "${id}" "${sfx}" )" || return 1
        [ -n "${devkey}" ] || return 1
        maybe_unlock "${dir}/unencrypted${sfx}" "${id}" "${devkey}" "${sfx}" || return 1
    done
}

is_osd_running() {
    osdid="${1:?missing}"

    skt="${SNAP_CURRENT}/run/ceph-osd.${osdid}.asok"

    nc -z -U "${skt}" >/dev/null 2>&1
}

spawn() {
    retry_pending=false
    for i in "${SNAP_COMMON}/data/osd"/*; do
        filename="$(basename "${i}")"
        [ -z "$filename" ] && continue

        nr="${filename##ceph-}"
        [ -z "$nr" ] && continue

        [ ! -e "${i}/ready" ] && continue

        is_osd_running "${nr}" && continue

        # Without its mapper the OSD cannot start either, so skip it and let
        # the retry loop try the unlock again (e.g. once the monitors answer
        # config-key requests) instead of stranding the OSDs after it.
        if ! unlock_osd "${i}" "${nr}"; then
            echo "osd.${nr}: failed to unlock encrypted device; will retry" >&2
            retry_pending=true
            continue
        fi

        # Start the OSD but tolerate per-OSD failure: a single OSD that
        # cannot start (e.g. its backing block device was removed without
        # purging the OSD first) must not abort the loop under `set -e`,
        # otherwise every later OSD on the node is stranded and the service
        # enters an endless restart loop. See issue #521.
        if ! ceph-osd --cluster ceph --id "${nr}"; then
            echo "osd.${nr} failed to start; will retry" >&2
            retry_pending=true
            continue
        fi
    done

}

# A mapper may appear after this service starts (or after Vault is unsealed).
# Retry failed starts without restarting healthy OSDs or blocking later OSDs.
# Once all starts succeed, retain the existing reload-driven idle behaviour.
timer_pid=""
reload_requested=false
request_reload() {
    reload_requested=true
    if [ -n "$timer_pid" ]; then
        kill "$timer_pid" 2>/dev/null || true
    fi
}
trap request_reload HUP

wait_for_config

while true; do
    reload_requested=false
    spawn
    "$reload_requested" && continue

    delay=infinity
    if "$retry_pending"; then
        delay=5
    fi
    sleep "$delay" &
    timer_pid=$!
    # Also handle a reload received between spawn and registering the timer.
    if "$reload_requested"; then
        kill "$timer_pid" 2>/dev/null || true
    fi
    wait "$timer_pid" || true
    timer_pid=""
done
