#!/bin/bash

# Each wait has its own limit; this is not a total startup deadline.
smb_wait_for_files() {
    local description="$1" path
    shift
    local deadline=$((SECONDS + ${SMB_WAIT_TIMEOUT:-300}))
    local -a missing
    while true; do
        missing=()
        for path in "$@"; do
            [ -s "${path}" ] || missing+=("${path}")
        done
        [ "${#missing[@]}" -eq 0 ] && return 0
        if [ "${SECONDS}" -ge "${deadline}" ]; then
            echo "Timed out waiting for ${description}" >&2
            printf 'Missing or empty: %s\n' "${missing[@]}" >&2
            return 1
        fi
        sleep "${SMB_POLL_INTERVAL:-2}"
    done
}

smb_wait_for_ctdb_ready() {
    local deadline=$((SECONDS + ${SMB_WAIT_TIMEOUT:-300}))
    while [ "${SECONDS}" -lt "${deadline}" ]; do
        # Core26's base timeout resolves outside the permitted executable paths.
        if "${SNAP}/bin/timeout" --kill-after=1s "${SMB_CTDB_PROBE_TIMEOUT:-5}" \
            "${SNAP}/commands/samba-command" ctdb pnn >/dev/null 2>&1; then
            return 0
        fi
        sleep "${SMB_POLL_INTERVAL:-2}"
    done
    echo "Timed out waiting for CTDB to report its node number" >&2
    return 1
}

smb_write_identity_baseline() {
    printf '%s\n' \
        'root:x:0:0:root:/root:/bin/false' \
        'nobody:x:65534:65534:nobody:/nonexistent:/bin/false' > "$1/passwd"
    printf '%s\n' 'root:x:0:' 'nogroup:x:65534:' > "$1/group"
}

# CTDB calls this too: only initialize missing files, never reset a running
# smbd's imported identities on an independent CTDB restart.
smb_prepare_identity_files() (
    set -eu
    exec 9>"${smb_identity_dir}/identity.lock"
    flock -w 30 9
    if [ ! -s "${smb_identity_dir}/passwd" ] || [ ! -s "${smb_identity_dir}/group" ]; then
        stage="$(mktemp -d "${smb_identity_dir}/identity-import.XXXXXX")"
        trap 'rm -rf "${stage}"' EXIT
        smb_write_identity_baseline "${stage}"
        mv "${stage}/passwd" "${smb_identity_dir}/passwd"
        mv "${stage}/group" "${smb_identity_dir}/group"
    fi
)

# smbd is stopped before its startup script runs. Import into fresh staging
# files so failed imports never publish a partially rebuilt NSS database.
smb_import_users() (
    set -eu
    exec 9>"${smb_identity_dir}/identity.lock"
    flock -w 30 9
    stage="$(mktemp -d "${smb_identity_dir}/identity-import.XXXXXX")"
    trap 'rm -rf "${stage}"' EXIT
    smb_write_identity_baseline "${stage}"
    NSS_WRAPPER_PASSWD="${stage}/passwd" NSS_WRAPPER_GROUP="${stage}/group" \
    "${SNAP}/bin/python3" "${SNAP}/commands/sambacc.start" "${smb_sambacc_args[@]}" \
        --etc-passwd-path "${stage}/passwd" --etc-group-path "${stage}/group" import-users
    mv "${stage}/passwd" "${smb_identity_dir}/passwd"
    mv "${stage}/group" "${smb_identity_dir}/group"
)

smb_prepare_runtime() {
    smb_config="${SNAP_DATA}/conf/samba/smb.conf"
    smb_identity_dir="${SNAP_DATA}/samba"
    smb_container_config="${smb_identity_dir}/container.json"
    smb_cluster_id_path="${smb_identity_dir}/cluster-id"
    smb_data_dir="${SNAP_COMMON}/data/samba"

    mkdir -p \
        "${smb_data_dir}/cache" \
        "${smb_data_dir}/lock/ctdb" \
        "${smb_data_dir}/ncalrpc" \
        "${smb_data_dir}/private" \
        "${smb_data_dir}/run" \
        "${smb_data_dir}/state" \
        "${smb_data_dir}/winbindd" \
        "${smb_data_dir}/ctdb/etc" \
        "${smb_data_dir}/ctdb/persistent" \
        "${smb_data_dir}/ctdb/run" \
        "${smb_data_dir}/ctdb/state" \
        "${smb_data_dir}/ctdb/volatile" \
        "${SNAP_COMMON}/logs/samba" \
        "${smb_identity_dir}"

    smb_wait_for_files "SMB configuration" \
        "${smb_config}" "${smb_container_config}" "${smb_cluster_id_path}"

    smb_prepare_identity_files

    local nss_wrapper=""
    for path in "${SNAP}"/lib/*/libnss_wrapper.so; do
        if [ -f "${path}" ]; then
            nss_wrapper="${path}"
            break
        fi
    done
    if [ -z "${nss_wrapper}" ]; then
        echo "Could not find libnss_wrapper.so" >&2
        exit 1
    fi
    export LD_PRELOAD="${nss_wrapper}"
    export NSS_WRAPPER_PASSWD="${smb_identity_dir}/passwd"
    export NSS_WRAPPER_GROUP="${smb_identity_dir}/group"

    smb_cluster_id="$(cat "${smb_cluster_id_path}")"
    smb_sambacc_args=(
        --identity "${smb_cluster_id}"
        --config "${smb_container_config}"
        --etc-passwd-path "${smb_identity_dir}/passwd"
        --etc-group-path "${smb_identity_dir}/group"
        --samba-command-prefix "${SNAP}/commands/samba-command"
        --validate-config=false
    )
    smb_config_sources=("${smb_container_config}")
    for user_config in "${smb_identity_dir}"/users-*.json; do
        [ -e "${user_config}" ] || continue
        smb_sambacc_args+=(--config "${user_config}")
        smb_config_sources+=("${user_config}")
    done
}

smb_prepare_ctdb_runtime() {
    smb_ctdb_config="${smb_identity_dir}/ctdb.json"
    smb_ctdb_rank_path="${smb_identity_dir}/ctdb-rank"
    smb_ctdb_identity_path="${smb_identity_dir}/ctdb-identity"
    smb_ctdb_address_path="${smb_identity_dir}/ctdb-address"

    smb_wait_for_files "CTDB configuration" \
        "${smb_ctdb_config}" "${smb_ctdb_rank_path}" \
        "${smb_ctdb_identity_path}" "${smb_ctdb_address_path}"

    smb_ctdb_rank="$(cat "${smb_ctdb_rank_path}")"
    # These variables are consumed by the service scripts sourcing this file.
    # shellcheck disable=SC2034
    smb_ctdb_identity="$(cat "${smb_ctdb_identity_path}")"
    # shellcheck disable=SC2034
    smb_ctdb_address="$(cat "${smb_ctdb_address_path}")"
    # shellcheck disable=SC2034
    smb_ctdb_nodes_path="/var/lib/ctdb/persistent/nodes"

    smb_sambacc_args+=(--config "${smb_ctdb_config}")
    smb_config_sources+=("${smb_ctdb_config}")
    export SAMBACC_CONFIG
    SAMBACC_CONFIG="$("${SNAP}/bin/python3" -c 'import json, sys; print(json.dumps(sys.argv[1:]))' "${smb_config_sources[@]}")"
    export SAMBACC_CTDB="ctdb-is-experimental"
    export SAMBACC_CEPH_ID="name=client.smb.config.${smb_cluster_id}"
    export SAMBA_SPECIFICS="daemon_cli_debug_output"
    export SAMBA_CONTAINER_ID="${smb_cluster_id}"
    export NODE_NUMBER="${smb_ctdb_rank}"
    export CTDB_SOCKET="/run/ctdb/ctdbd.socket"
}
